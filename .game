# vim: set filetype=game:
# game: celestial-data, which finds and fetches what the archives hold
#
# name says which project this is. the builder's config has a block for
# it that says where its road is; this file never names a remote.
name celestial-data

# lint rules, copied from the builder's so both of us lint alike.
lint width 80
lint rows 25
lint comments
lint print
lint exclaim
lint shout
lint words hyperscaler enterprise-grade blazing-fast load-bearing
lint paragraph 4

lint allow README.md words paragraph rows

# so shouty oof
lint abbreviations APOGEE ASPCAP ASPCAPFLAG ELEMFLAG EXTRATARG FIELD GALAH
lint abbreviations GLIMPSE HEASARC HERMES HIRES LAMOST MAKEE MARCS MODIS
lint abbreviations NICMOS PPMAP SARAO STARFLAG TARGET TFORM TNULL TUNIT VESTA
lint abbreviations VIIRS VSCATTER

sweep allow chroma/chroma.go author
sweep allow chroma/chroma_test.go author

# test data is scrungy, quit complaining ok
exclude testdata
exclude lamost/testdata

# mocks
run mocks . :: go tool mockgen -write_package_comment=false -destination mocks/web.go -package mocks github.com/janearc/celestial-data/web Web
run mocks . :: go tool mockgen -write_package_comment=false -destination mocks/normal.go -package mocks github.com/janearc/celestial-data/gaia Normal
run mocks . :: go tool mockgen -write_package_comment=false -destination mocks/searcher.go -package mocks github.com/janearc/celestial-data/arxiv Searcher
run mocks . :: go tool mockgen -write_package_comment=false -destination mocks/clock.go -package mocks github.com/janearc/celestial-data/arxiv Clock
